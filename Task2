import random
from enum import Enum

INF = float('inf')

class Algorithm(Enum):
    FERMAT = '1'
    SOLOVAY_STRASSEN = '2'
    MILLER_RABIN = '3'

def fermat(n):
    if n <= 1:
        return False
    for _ in range(5):
        a = random.randint(2, n-1)
        if pow(a, n-1, n) != 1:
            return False
    return True

def solovay_strassen(n):
    if n <= 1:
        return False
    for _ in range(5):
        a = random.randint(2, n-1)
        x = pow(a, (n-1)//2, n)
        if x != 1 and x != n-1:
            return False
    return True

def miller_rabin(n):
    if n <= 1:
        return False
    s = 0
    d = n-1
    while d % 2 == 0:
        s += 1
        d //= 2
    for _ in range(5):
        a = random.randint(2, n-2)
        x = pow(a, d, n)
        if x == 1 or x == n-1:
            continue
        for _ in range(s-1):
            x = pow(x, 2, n)
            if x == n-1:
                break
        else:
            return False
    return True

def main():
    print("1 - Ферма")
    print("2 - Соловей-Штрассен")
    print("3 - Миллер-Рабин")
    
    choice = input("Выбор: ")
    n = int(input("Число: "))
    
    map = {
        Algorithm.FERMAT.value: fermat,
        Algorithm.SOLOVAY_STRASSEN.value: solovay_strassen,
        Algorithm.MILLER_RABIN.value: miller_rabin
    }
    
    if choice in map:
        result = map[choice](n)
        print("Простое" if result else "Составное")
    else:
        print("Неверный выбор")

if __name__ == "__main__":
    main()
